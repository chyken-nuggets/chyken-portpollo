---
/**
 * Terminal block cursor. Blinks unless `blink={false}` or the visitor prefers
 * reduced motion, in which case it stays solid.
 */
interface Props {
  blink?: boolean;
  class?: string;
}

const { blink = true, class: className } = Astro.props;
---

<span class:list={['cursor', { 'cursor--blink': blink }, className]} aria-hidden="true"></span>

<style>
  .cursor {
    display: inline-block;
    width: 0.62em;
    height: 1.2em;
    margin-left: 0.2ch;
    vertical-align: -0.24em;
    background: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor--blink {
      animation: cursor-blink 1.1s steps(1, end) infinite;
    }
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }
</style>
