---
/**
 * A pre-generated halftone (transparent PNG of dots) rendered through
 * astro:assets as responsive WebP. The dots sit straight on the page colour.
 *
 * Generate the source with `npm run halftone`; see halftone.config.mjs.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** Describe the subject. Use alt="" only when the image is purely decorative. */
  alt: string;
  sizes?: string;
  widths?: number[];
  /** Above-the-fold images: load eagerly with high fetch priority. */
  priority?: boolean;
  class?: string;
  style?: string;
}

const {
  src,
  alt,
  sizes = '(min-width: 64rem) 45vw, 92vw',
  widths = [480, 800, 1200, 1600],
  priority = false,
  class: className,
  style,
} = Astro.props;

// Never upscale: keep widths below the source, plus the source width itself.
const usable = [...new Set([...widths.filter((w) => w < src.width), Math.min(src.width, Math.max(...widths))])].sort(
  (a, b) => a - b,
);
---

<Image
  src={src}
  alt={alt}
  widths={usable}
  sizes={sizes}
  format="webp"
  priority={priority}
  class:list={['halftone', className]}
  style={style}
/>

<style>
  .halftone {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
